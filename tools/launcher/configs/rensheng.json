{
  "schema": 1,
  "product_id": "rensheng",
  "product_name": "人生重启系统",
  "window_title": "人生重启系统",
  "window": {
    "width": 1280,
    "height": 820,
    "min_width": 980,
    "min_height": 640,
    "background": "#100F0D"
  },
  "port": 8791,
  "host": "0.0.0.0",
  "port_fallback_count": 45,
  "mutex_name": "rensheng_single_instance_v1",
  "health": {
    "path": "/api/bootstrap",
    "match": "人生重启系统",
    "timeout_sec": 20
  },
  "backend": {
    "command": ["{root}\\start.bat", "--backend", "{port}", "{host}"],
    "cwd": "{root}",
    "startup_timeout_sec": 90,
    "startup_max_wait_sec": 300,
    "retry_limit": 3,
    "watchdog_interval_sec": 30,
    "watchdog_failures": 2,
    "watchdog_restart_timeout_sec": 45
  },
  "tray": {
    "tooltip": "人生重启系统",
    "show": "显示主界面",
    "browser": "用浏览器打开",
    "autostart": "开机自启",
    "quit": "退出"
  },
  "splash": {
    "title": "人生重启系统",
    "subtitle": "正在准备你的工作台",
    "logo": "{root}\\app\\web\\brand\\on-dark\\logo-64.png",
    "accent": "#e3b341",
    "background": "#100F0D",
    "text": "#fbf8f1",
    "muted": "#8f887c"
  },
  "icon": {
    "path": "{root}\\app\\web\\brand\\app.ico",
    "letter": "人",
    "background": "#6A60BE",
    "foreground": "#FFFFFF"
  },
  "log_dir": "{root}\\.runtime\\launcher\\{product_id}",
  "autostart": {
    "value_name": "人生重启系统",
    "command": "wscript.exe \"{root}\\启动工作台-无黑窗.vbs\"",
    "default": false
  },
  "update_url": "",
  "webview2": {
    "guide_url": "https://developer.microsoft.com/zh-cn/microsoft-edge/webview2/"
  }
}
